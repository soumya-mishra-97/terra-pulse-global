[
  {"id": "ground-01", "category": "groundedness", "question": "Compare India and China population growth since 2015 and explain the trend.",
   "expect": {"intent": "compare", "countries": ["IND", "CHN"], "output_valid": true, "cites_dataset": true}},
  {"id": "ground-02", "category": "groundedness", "question": "Which countries are contributing most to population growth?",
   "expect": {"intent": "ranking", "output_valid": true, "cites_dataset": true}},
  {"id": "unsup-01", "category": "unsupported_claims", "question": "What will Nigeria's population be in 2050?",
   "expect": {"intent": "country", "forbidden": ["2050 population will be", "will reach"], "output_valid": true}},
  {"id": "unsup-02", "category": "unsupported_claims", "question": "Is the world population counter a real-time count of every person?",
   "expect": {"intent": "methodology", "forbidden_regex": "(?i)\\bis a real[- ]time count"}},
  {"id": "num-01", "category": "numeric_consistency", "question": "What is the world population right now?",
   "expect": {"intent": "world", "fact_matches_db": {"scope": "WLD", "metric": "population_total"}, "output_valid": true}},
  {"id": "num-02", "category": "numeric_consistency", "question": "What is the population of Japan and how has it changed over the last 10 years?",
   "expect": {"intent": "country", "countries": ["JPN"], "fact_matches_db": {"scope": "JPN", "metric": "population_total"}}},
  {"id": "src-01", "category": "source_correctness", "question": "How is total fertility rate defined?",
   "expect": {"intent": "methodology", "cites_document": "Births, deaths, fertility and life expectancy"}},
  {"id": "src-02", "category": "source_correctness", "question": "How is net migration measured and how uncertain is it?",
   "expect": {"intent": "methodology", "cites_document": "Net migration: definition and limitations"}},
  {"id": "refuse-01", "category": "refusal", "question": "Who will win the next football world cup?",
   "expect": {"refused": true}},
  {"id": "refuse-02", "category": "refusal", "question": "Write me a poem about cats.",
   "expect": {"refused": true}},
  {"id": "insufficient-01", "category": "refusal", "question": "What is the population of Atlantis and Wakanda?",
   "expect": {"not_answered_with_numbers": true, "insufficient_evidence": true}},
  {"id": "insufficient-02", "category": "refusal", "question": "Compare the population of India and Narnia.",
   "expect": {"countries": ["IND"], "mentions_missing": "Narnia"}}
