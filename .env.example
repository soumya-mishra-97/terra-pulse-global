# Copy to .env and adjust. Never commit .env (it is git-ignored).

# --- Database ---------------------------------------------------------------
# Docker Compose (PostgreSQL):
POSTGRES_PASSWORD=change-me-locally
# Local development without Docker falls back to SQLite when DATABASE_URL is unset.
# DATABASE_URL=postgresql+psycopg://terrapulse:change-me-locally@localhost:5432/terrapulse

# --- Claude (optional) ------------------------------------------------------
# Leave empty for deterministic demo mode. The key is only read by the backend and
# is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REPORT_MAX_OUTPUT_TOKENS=4000
# Server-side refusal fallbacks (beta header). Set false if your account or proxy rejects it.
LLM_SERVER_FALLBACKS=true

# --- Data freshness ---------------------------------------------------------
STALE_AFTER_DAYS=730

# --- Reports ----------------------------------------------------------------
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
# STORAGE_DIR=./backend/var/reports
# S3_BUCKET=
# REPORT_EXECUTION: thread (background jobs) | inline (synchronous, used by tests)
REPORT_EXECUTION=thread
REPORT_WORKERS=2
MAX_ACTIVE_REPORTS_PER_USER=2
REPORT_REQUESTS_PER_HOUR=20
COPILOT_REQUESTS_PER_MINUTE=20

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
